# Copy this file to `.env.deploy` in the same folder and fill in the values
# below. `.env.deploy` itself is gitignored — it will hold real values, never
# commit it.
#
# Required (you provide these):
GCP_PROJECT_ID=
GCP_REGION=asia-south1

# Optional — only needed for Model 3's AI route-explanation text. Leave
# blank to skip; the app degrades gracefully to a templated explanation.
# Get one at https://console.mistral.ai (API Keys).
MISTRAL_API_KEY=

# Optional — override if you don't want deploy.sh to auto-generate these.
# Leave blank to have deploy.sh generate strong random values and store
# them only in Secret Manager (recommended — nothing sensitive ends up in
# this file).
DB_PASSWORD=
JWT_SECRET=

# Cloud SQL instance settings — safe to leave as-is for a hackathon-scale
# deployment. db-f1-micro is the smallest/cheapest tier.
DB_INSTANCE_NAME=himdrishti-db
DB_TIER=db-f1-micro

# Artifact Registry repo name (created automatically if missing).
AR_REPO=himdrishti
