# Production image for Cloud Run — a real static build served by nginx,
# instead of the local Dockerfile's `npm run dev` (a dev server, fine for
# local hot-reload, not meant to serve real traffic). The local Dockerfile
# is intentionally untouched so `docker compose up` keeps working exactly
# as it always has.
#
# VITE_API_BASE_URL is a Vite BUILD-TIME constant — it gets baked into the
# compiled JS, not read at container start. That means the api-gateway must
# already be deployed (so you have its real Cloud Run URL) before building
# this image. See deployment/gcp/deploy.sh, which handles this ordering.
#
# Build from the frontend/ directory:
#   docker build -f Dockerfile.prod \
#     --build-arg VITE_API_BASE_URL=https://<api-gateway-url>/api \
#     -t frontend .

FROM node:20-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
