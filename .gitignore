# Temp/scratch files
tmp/
temp/
*.tmp

# NOTE: real trained model weights (ml/artifacts/**/*.keras, *.pkl, etc.)
# are intentionally NOT ignored — they are required at runtime for Model 1/2
# to produce the same output as local. A previous blanket *.keras/*.h5/*.pb
# rule here silently excluded the real trained LSTM
# (ml/artifacts/sea_ice_forecasting_model/sic_lstm_best.keras) from the
# repository; a fresh clone would have been missing it and Model 1 would
# have silently fallen back to the secondary GBR model instead, changing
# real behavior. Only build-time/IDE caches are ignored below.

# OS specific
.DS_Store
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Docker
.docker/
docker-compose.override.yml

# NOTE: docs/ was previously fully git-ignored, which would have permanently
# excluded real project documentation (docs/Model 3 changes.docx) from the
# repository. Documentation belongs in git (just not copied into Docker
# build contexts — see .dockerignore) so it isn't lost.

# Temporary testing scripts
scripts/

# GCP deployment — real project ID, secrets and the locally-cached DB
# password used between deploy.sh phases. Never commit this.
deployment/gcp/.env.deploy
deployment/gcp/.db_password.local
